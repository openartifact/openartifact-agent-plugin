          "min_age",
          "repository",
          "package",
          "version"
        ],
        "additionalProperties": false
      },
      "title": "Check package availability"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Check dependencies"
      },
      "description": "Check many package versions at once (a lockfile, or the dependencies you are about to add) against a repository, including a group. Returns one result per package version, in order, each with status: available, held (reasons as in check_availability), not_found (no member has the version) or unknown (a proxy has not cached the package's metadata, so whether it has the version cannot be told; install or fetch the package once), and repository, the member that decided. A group decides like serving does: the first member that has the version decides even when it holds it back, and unless merge_proxy_versions is set a package a hosted member holds is decided by the hosted members only. Reads cached upstream metadata only; the upstream is never asked. At most 1000 package versions. Requires read permission on the repository.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Repository name: hosted, proxy or group"
          },
          "packages": {
