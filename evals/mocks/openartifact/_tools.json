              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "package": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "package",
                "version"
              ],
              "additionalProperties": false
            },
            "description": "Package versions to check, 1 to 1000 (package and version each)"
          }
        },
        "required": [
          "repository",
          "packages"
        ],
        "additionalProperties": false
      },
